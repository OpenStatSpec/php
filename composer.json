{
  "name": "openstatspec/php",
  "description": "PHP reference adapter for the OpenStatSpec relational statistical-data specification.",
  "type": "library",
  "license": "MIT",
  "archive": {
    "exclude": [
      "/.git",
      "/.php-cs-fixer.cache",
      "/.phpunit.result.cache",
      "/vendor"
    ]
  },
  "require": {
    "ext-pdo": "*",
    "php": "^8.4.1",
    "openstatspec/spss-sav": "^3.0"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/OpenStatSpec/php-spss.git"
    }
  ],
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "OpenStatSpec\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OpenStatSpec\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress",
    "check": [
      "composer validate --strict",
      "@lint",
      "@style",
      "@analyse",
      "@test"
    ],
    "fix": "php-cs-fixer fix --diff",
    "lint": "find src tests tools -type f -name '*.php' -print0 | xargs -0 -n1 php -l",
    "style": "php-cs-fixer fix --dry-run --diff",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.4.1"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
